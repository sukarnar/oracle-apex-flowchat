{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowchat.local/flow.schema.json",
  "title": "FlowChat flow definition",
  "type": "object",
  "required": ["flowId", "start", "nodes"],
  "properties": {
    "flowId":   { "type": "string", "pattern": "^[a-z0-9_]{1,100}$" },
    "version":  { "type": "integer", "minimum": 1 },
    "name":     { "type": "string" },
    "start":    { "type": "string", "description": "Id of the first node" },
    "context":  { "type": "array", "description": "Context variables the page passes in (<flow-chat context=\"dept:P10_DEPT\">). Each fills the slot of the same name; every context value is also readable as context.<name>.",
                  "items": { "oneOf": [{ "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" },
                                       { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "label": { "type": "string" } } }] } },
    "debug":    { "type": "boolean", "default": false, "description": "Log every step, branch, connector call and search (FC_EVENTS rows with direction DBG; onDebug in the JS engine). PII values are masked." },
    "piiSlots": { "type": "array", "items": { "type": "string" }, "description": "Slots (e.g. set by a lookup or page context) whose values logs must redact. For asked questions use \"pii\" on the question. context.<name> marks a page context value." },
    "resumeText": { "type": "string", "description": "Shown when a conversation is picked up again after a page reload (input {\"command\": \"resume\"})." },
    "bindings": {
      "type": "object",
      "description": "slot -> where the value is mirrored on the host page, one key per adapter",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "apex": { "type": "string", "description": "APEX page item name, e.g. P10_EMAIL" },
          "dom":  { "type": "string", "description": "CSS selector of an input/select/checkbox" },
          "required": { "type": "boolean", "description": "Designer hint: warn if some path to submit skips this field" }
        },
        "additionalProperties": { "type": "string" }
      }
    },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,200}$" },

    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ui": { "type": "object", "description": "Designer canvas position; ignored by the engines",
                "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }
      },
      "oneOf": [
        { "$ref": "#/$defs/message" }, { "$ref": "#/$defs/ask" }, { "$ref": "#/$defs/condition" },
        { "$ref": "#/$defs/lookup" },  { "$ref": "#/$defs/summary" }, { "$ref": "#/$defs/submit" },
        { "$ref": "#/$defs/end" },
        { "$ref": "#/$defs/verify" },
        { "$ref": "#/$defs/findRecord" }, { "$ref": "#/$defs/changeFields" }, { "$ref": "#/$defs/saveChanges" },
        { "$ref": "#/$defs/repeat" }, { "$ref": "#/$defs/bulkUpdate" }, { "$ref": "#/$defs/set" }, { "$ref": "#/$defs/menu" },
        { "$ref": "#/$defs/email" },
        { "$ref": "#/$defs/teams" },
        { "$ref": "#/$defs/agent" },
        { "$ref": "#/$defs/rest" }
      ]
    },

    "menu": {
      "description": "Fixed options shown as buttons (pills); each option leads to its own next node. Shown every time the flow reaches it, so later steps can loop back.",
      "properties": {
        "type": { "const": "menu" },
        "prompt": { "type": "string" },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$", "description": "Optional field that keeps the chosen value" },
        "label": { "type": "string" },
        "invalidMessage": { "type": "string" },
        "emptyMessage": { "type": "string" },
        "options": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["value", "next"],
          "properties": {
            "value": { "type": ["string", "number"] },
            "label": { "type": "string", "description": "Button text; may use {{placeholders}}" },
            "when": { "$ref": "#/$defs/condExpr", "description": "Show the option only while this holds" },
            "next": { "$ref": "#/$defs/id" } } } }
      },
      "required": ["options"]
    },

    "agent": {
      "description": "A model-driven step that works toward a goal: asks the user questions (rendered and checked by FlowChat), calls registered tools and skills, then fills its output fields (next), hands off to an exit, or fails (onError). The loop runs in FC_ENGINE; providers, tools and skills live in FC_AI_PROVIDERS, FC_AI_TOOLS and FC_AI_SKILLS.",
      "properties": {
        "type": { "const": "agent" },
        "provider": { "type": "string", "description": "FC_AI_PROVIDERS id (JS engine: options.aiProviders key)" },
        "goal": { "type": "string", "description": "The task; may use {{placeholders}}" },
        "instructions": { "type": "string" },
        "intro": { "type": "string", "description": "Said when the agent starts" },
        "inputs": { "type": "array", "items": { "type": "string" }, "description": "Slots, alias.field or context.<name> values the model may see (PII is hidden unless sendPii)" },
        "sendPii": { "type": "boolean", "default": false, "description": "Send PII values to the model as they are, instead of [PII_n] placeholders" },
        "tools": { "type": "array", "items": { "type": "string" }, "description": "FC_AI_TOOLS ids the agent may call; write tools ask the user to confirm first" },
        "skills": { "type": "array", "items": { "type": "string" }, "description": "FC_AI_SKILLS ids the agent may load" },
        "outputs": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$", "description": "The slot it fills" },
          "label": { "type": "string" }, "description": { "type": "string", "description": "Hint for the model" },
          "kind": { "enum": ["text", "number", "date", "email", "yesno", "choice", "file"], "default": "text", "description": "file: filled only by the user's upload (ask_user)" },
          "pii": { "enum": [true, false, "full", "last4"], "description": "Personal data: masked in logs and sent to the model as a [PII_n] placeholder unless sendPii" },
          "accept": { "type": "string", "description": "file: allowed types, e.g. .pdf,.jpg" }, "maxSizeKb": { "type": "integer" },
          "required": { "type": "boolean", "default": true },
          "options": { "type": "array", "items": { "type": ["string", "object"] } },
          "min": { "type": "number" }, "max": { "type": "number" },
          "minDate": { "type": "string" }, "maxDate": { "type": "string" },
          "minLength": { "type": "integer" }, "maxLength": { "type": "integer" } } } },
        "exits": { "type": "array", "items": { "type": "object", "required": ["name", "next"], "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,49}$" }, "description": { "type": "string" },
          "next": { "$ref": "#/$defs/id" } } } },
        "limits": { "type": "object", "properties": {
          "maxSteps": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
          "maxQuestions": { "type": "integer", "minimum": 0, "maximum": 50, "default": 10 },
          "maxCallsPerTurn": { "type": "integer", "minimum": 1, "maximum": 20, "default": 4 } } },
        "errorMessage": { "type": "string" },
        "continueText": { "type": "string" },
        "next": { "$ref": "#/$defs/id" },
        "onError": { "$ref": "#/$defs/id" }
      },
      "required": ["provider", "goal"]
    },

    "email": {
      "description": "Send an email built from templates over the answers. Without a connector the PL/SQL engine queues it with APEX_MAIL (the JS engine calls options.sendEmail). Not sent again when an Edit replays the flow.",
      "properties": {
        "type": { "const": "email" },
        "to": { "type": "string", "description": "Recipients, comma or semicolon separated; may use {{placeholders}}" },
        "cc": { "type": "string" },
        "bcc": { "type": "string" },
        "replyTo": { "type": "string" },
        "from": { "type": "string", "description": "Sender address. Required for APEX_MAIL (no connector)" },
        "subject": { "type": "string", "description": "One line; may use {{placeholders}}" },
        "body": { "type": "string", "description": "Plain text with {{placeholders}}; also sent as escaped HTML" },
        "attachments": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" }, "description": "File-answer slots to attach" },
        "connector": { "type": "string", "description": "Optional. Receives the payload plus {to, cc, bcc, replyTo, from, subject, body, attachments}; returns {ok, message?}" },
        "message": { "type": "string", "description": "Shown in the chat after sending" },
        "errorMessage": { "type": "string", "description": "Shown when sending fails" },
        "next": { "$ref": "#/$defs/id" },
        "onError": { "$ref": "#/$defs/id", "description": "Where to go when sending fails (default: next)" }
      },
      "required": ["to", "subject"]
    },

    "teams": {
      "description": "Post a card to a Microsoft Teams channel: a Teams Workflows webhook registered in FC_TEAMS_CHANNELS (PL/SQL engine, via FC_CHANNEL) or options.postToTeams (JS engine). One way: the card can open a link but nobody answers it. Not posted again when an Edit replays the flow.",
      "properties": {
        "type": {
          "const": "teams"
        },
        "channel": {
          "type": "string",
          "description": "A channel name in FC_TEAMS_CHANNELS (the workflow URL stays in the database)"
        },
        "title": {
          "type": "string",
          "description": "One line; may use {{placeholders}}"
        },
        "text": {
          "type": "string",
          "description": "Simple Markdown with {{placeholders}}; links typed in answers are not made clickable"
        },
        "style": {
          "enum": [
            "default",
            "emphasis",
            "good",
            "attention",
            "warning",
            "accent"
          ],
          "default": "default",
          "description": "Background of the title"
        },
        "facts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "title",
              "value"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          "description": "Label/value rows; rows whose value is empty are left out"
        },
        "link": {
          "type": "string",
          "description": "Optional https:// URL for an Open button"
        },
        "linkLabel": {
          "type": "string",
          "default": "Open"
        },
        "connector": {
          "type": "string",
          "description": "Optional. Receives the payload plus {channel, title, text, facts, link, linkLabel, style}; returns {ok, message?}"
        },
        "message": {
          "type": "string",
          "description": "Shown in the chat after posting"
        },
        "errorMessage": {
          "type": "string",
          "description": "Shown when posting fails"
        },
        "next": {
          "$ref": "#/$defs/id"
        },
        "onError": {
          "$ref": "#/$defs/id",
          "description": "Where to go when posting fails (default: next)"
        }
      },
      "required": [
        "channel"
      ]
    },

    "rest": {
      "description": "Call a REST API registered in FC_REST_ENDPOINTS (JS engine: options.restEndpoints or options.rest) and put parts of its JSON answer into slots. 2xx -> next, 404 -> onNotFound (when set), anything else -> onError (without it the conversation fails). On an Edit replay a GET runs again quietly; other methods are not repeated.",
      "properties": {
        "type": {"const": "rest"},
        "endpoint": {"type": "string", "description": "FC_REST_ENDPOINTS.ENDPOINT_ID: base URL, Web Credential and allowed methods live there"},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"], "default": "GET"},
        "path": {"type": "string", "pattern": "^([/?].*)?$", "description": "Relative to the endpoint's base URL; {{placeholders}} are URL-encoded"},
        "query": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Query parameters: name -> template"},
        "skipEmptyQuery": {"type": "boolean", "description": "Leave out query parameters whose value is empty"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Extra headers (templates). Authorization, Cookie, Host and the like are refused: they belong to the endpoint"},
        "body": {"description": "JSON body template (not for GET): a string \"{{slot}}\" alone keeps the value's type; other strings are filled in as text"},
        "map": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,99}$"}, "additionalProperties": {"type": "string"}, "description": "slot -> JSON path in the answer ($.a.b[0].c, or $ for all of it)"},
        "statusSlot": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$", "description": "Slot that receives the HTTP status"},
        "message": {"type": "string", "description": "Shown after a successful call"},
        "notFoundMessage": {"type": "string", "description": "Shown on a 404 that goes to onNotFound"},
        "errorMessage": {"type": "string", "description": "Shown when the call fails"},
        "next": {"$ref": "#/$defs/id"},
        "onNotFound": {"$ref": "#/$defs/id"},
        "onError": {"$ref": "#/$defs/id"}
      },
      "required": ["endpoint"]
    },

    "set": {
      "description": "Initialise or copy values into slots, in order, without asking anything. Runs again when the flow is replayed after an Edit.",
      "properties": {
        "type": { "const": "set" },
        "assign": { "type": "array", "items": { "type": "object", "required": ["slot"],
          "properties": {
            "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" },
            "value": { "description": "A fixed value (text, number or boolean)" },
            "template": { "type": "string", "description": "Text with {{placeholders}}" },
            "from": { "type": "string", "description": "Copy of a slot, alias.field, context.<name>, <list>.count or app_user" },
            "clear": { "type": "boolean" },
            "onlyIfEmpty": { "type": "boolean", "default": false, "description": "Keep a value that is already there" } } } },
        "next": { "$ref": "#/$defs/id" }
      },
      "required": ["assign", "next"]
    },

    "pii": { "description": "Mask this value in FC_EVENTS and debug logs: true = [redacted], \"last4\" = only the last 4 characters", "enum": [true, false, "last4"] },

    "repeat": {
      "description": "Collect a list of items, each with its own questions. The slot holds [{field: value}, ...]; <slot>.count is the number of items. The widget shows the items with Remove, Add and Done.",
      "properties": {
        "type": { "const": "repeat" },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" },
        "label": { "type": "string", "description": "Shown in the summary and list card" },
        "itemLabel": { "type": "string", "default": "item", "description": "What one item is called; {{item}} in messages" },
        "prompt": { "type": "string", "description": "Intro said when the step starts" },
        "itemTitle": { "type": "string", "description": "Template over the item's fields, e.g. \"{{description}} ({{amount}})\"" },
        "min": { "type": "integer", "minimum": 0, "default": 1 },
        "max": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
        "skipIfFilled": { "type": "boolean", "default": false },
        "fields": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["field"],
          "properties": { "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,49}$" }, "label": { "type": "string" },
                          "prompt": { "type": "string", "description": "{{n}} = item number; earlier fields of the item are available" },
                          "input": { "$ref": "#/$defs/input" },
                          "validators": { "type": "array", "items": { "$ref": "#/$defs/validator" } },
                          "pii": { "$ref": "#/$defs/pii" } } } },
        "addLabel": { "type": "string" }, "firstAddLabel": { "type": "string" }, "doneLabel": { "type": "string" },
        "removeLabel": { "type": "string" }, "listTitle": { "type": "string" },
        "prompts": { "type": "object", "properties": {
          "added": { "type": "string" }, "removed": { "type": "string" }, "menu": { "type": "string" },
          "tooFew": { "type": "string" }, "full": { "type": "string" }, "empty": { "type": "string" } } },
        "next": { "$ref": "#/$defs/id" }
      },
      "required": ["slot", "fields", "next"]
    },

    "bulkUpdate": {
      "description": "Search a data source, show how many records match, and after an explicit confirmation apply the same change to each one through the data source (whitelist, row filter and version checks apply per row).",
      "properties": {
        "type": { "const": "bulkUpdate" },
        "source": { "type": "string" },
        "criteria": { "type": "array", "items": { "type": "object", "required": ["field", "slot"],
          "properties": { "field": { "type": "string" }, "op": { "enum": ["eq", "starts", "contains", "gte", "lte"] },
                          "slot": { "type": "string" } } } },
        "minCriteria": { "type": "integer", "minimum": 1, "default": 1 },
        "byRowFilter": { "type": "boolean", "default": false },
        "requireVerified": { "type": "string" },
        "set": { "type": "object", "description": "field -> {\"value\": ...} or {\"slot\": \"answer\"}, optional \"label\"",
          "additionalProperties": { "type": "object", "properties": { "value": {}, "slot": { "type": "string" }, "label": { "type": "string" } } } },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
        "card": { "type": "object", "properties": { "title": { "type": "string" }, "subtitle": { "type": "string" } } },
        "confirmLabel": { "type": "string", "default": "Update {{count}}" }, "cancelLabel": { "type": "string" },
        "prompts": { "type": "object", "properties": {
          "confirm": { "type": "string" }, "done": { "type": "string" }, "partial": { "type": "string" },
          "none": { "type": "string" }, "tooMany": { "type": "string" }, "cancelled": { "type": "string" },
          "listTitle": { "type": "string" } } },
        "done": { "$ref": "#/$defs/id" },
        "none": { "$ref": "#/$defs/id", "description": "No match, or cancelled without a cancelled port" },
        "tooMany": { "$ref": "#/$defs/id" }, "cancelled": { "$ref": "#/$defs/id" },
        "partial": { "$ref": "#/$defs/id", "description": "Some records could not be changed. Defaults to done." }
      },
      "required": ["source", "set", "done"]
    },

    "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,49}$", "description": "Record alias; fields are read as alias.field" },

    "verify": {
      "description": "Send a one-time code to an answer (email/phone) through a connector and check it. Only a salted hash is stored. Once verified, the value is passed to data sources (:FC_VERIFIED) and changing the answer needs a new code.",
      "properties": {
        "type": { "const": "verify" },
        "slot": { "type": "string", "description": "The answer the code is sent to" },
        "channel": { "enum": ["email", "sms"], "default": "email" },
        "connector": { "type": "string", "description": "Receives {channel, to, code, ttlMinutes}; returns {ok, message?}" },
        "codeLength": { "type": "integer", "minimum": 4, "maximum": 10, "default": 6 },
        "ttlMinutes": { "type": "integer", "minimum": 1, "default": 10 },
        "maxAttempts": { "type": "integer", "minimum": 1, "default": 3 },
        "maxResends": { "type": "integer", "minimum": 0, "default": 2 },
        "label": { "type": "string" }, "placeholder": { "type": "string" }, "resendLabel": { "type": "string" },
        "prompts": { "type": "object", "properties": {
          "sent": { "type": "string" }, "wrong": { "type": "string" }, "success": { "type": "string" },
          "locked": { "type": "string" }, "expired": { "type": "string" }, "resent": { "type": "string" },
          "tooManySends": { "type": "string" } } },
        "verified": { "$ref": "#/$defs/id" },
        "failed": { "$ref": "#/$defs/id", "description": "Too many wrong codes, or sending failed. Without it the conversation fails." }
      },
      "required": ["type", "slot", "connector", "verified"]
    },

    "findRecord": {
      "description": "Search a data source; pick among several matches; load the chosen record as <as>.*",
      "properties": {
        "type": { "const": "findRecord" },
        "source": { "type": "string", "description": "FC_DATA_SOURCES.source_id" },
        "as": { "$ref": "#/$defs/alias" },
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["field", "slot"],
          "properties": { "field": { "type": "string" }, "op": { "enum": ["eq", "starts", "contains", "gte", "lte"] },
                          "slot": { "type": "string" }, "optional": { "type": "boolean" } } } },
        "minCriteria": { "type": "integer", "minimum": 1, "default": 1 },
        "byRowFilter": { "type": "boolean", "default": false, "description": "No criteria: the data source's row filter alone picks the rows (e.g. the signed-in user's records via :APP_USER). Refused by the server if the source has no row filter" },
        "requireVerified": { "type": "string", "description": "Slot that must have passed a Verify step with its current value; otherwise the search is refused" },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
        "autoPick": { "type": "boolean", "default": true, "description": "Load directly when exactly one record matches" },
        "allowNone": { "type": "boolean", "default": true }, "noneLabel": { "type": "string" },
        "card": { "type": "object", "properties": { "title": { "type": "string" }, "subtitle": { "type": "string" } },
                  "description": "Result card text; {{field}} placeholders use the row's (masked) values" },
        "prompts": { "type": "object", "properties": { "many": { "type": "string" }, "none": { "type": "string" },
          "tooMany": { "type": "string" }, "found": { "type": "string" }, "cancelled": { "type": "string" }, "gone": { "type": "string" } } },
        "found": { "$ref": "#/$defs/id" }, "notFound": { "$ref": "#/$defs/id" },
        "tooMany": { "$ref": "#/$defs/id" }, "cancelled": { "$ref": "#/$defs/id" }
      },
      "required": ["source", "as", "found"],
      "anyOf": [{ "required": ["criteria"] }, { "required": ["byRowFilter"], "properties": { "byRowFilter": { "const": true } } }]
    },

    "changeFields": {
      "description": "Show the record's editable fields; the user changes any of them, then Done",
      "properties": {
        "type": { "const": "changeFields" },
        "record": { "$ref": "#/$defs/alias" },
        "cardTitle": { "type": "string" }, "prompt": { "type": "string" }, "againPrompt": { "type": "string" },
        "doneLabel": { "type": "string" }, "noChangesText": { "type": "string" },
        "fields": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["field"],
          "properties": {
            "field": { "type": "string" }, "label": { "type": "string" }, "prompt": { "type": "string" },
            "input": { "$ref": "#/$defs/input" },
            "validators": { "type": "array", "items": { "$ref": "#/$defs/validator" } },
            "editableWhen": { "$ref": "#/$defs/condExpr" }, "lockedMessage": { "type": "string" },
            "pii": { "$ref": "#/$defs/pii" } } } },
        "done": { "$ref": "#/$defs/id" }, "noChanges": { "$ref": "#/$defs/id" }
      },
      "required": ["record", "fields", "done"]
    },

    "saveChanges": {
      "description": "Send only changed fields with the record version; handles conflicts and permissions",
      "properties": {
        "type": { "const": "saveChanges" },
        "record": { "$ref": "#/$defs/alias" },
        "savedText": { "type": "string" }, "conflictText": { "type": "string" }, "noChangesText": { "type": "string" },
        "saved": { "$ref": "#/$defs/id" }, "conflict": { "$ref": "#/$defs/id" }, "forbidden": { "$ref": "#/$defs/id" },
        "error": { "$ref": "#/$defs/id" }, "noChanges": { "$ref": "#/$defs/id" }
      },
      "required": ["record", "saved"]
    },

    "message": {
      "properties": { "type": { "const": "message" }, "text": { "type": "string" }, "next": { "$ref": "#/$defs/id" } },
      "required": ["text", "next"]
    },

    "ask": {
      "properties": {
        "type":   { "const": "ask" },
        "slot":   { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" },
        "label":  { "type": "string" },
        "prompt": { "type": "string", "description": "Supports {{slot}} placeholders" },
        "skipIfFilled": { "type": "boolean", "default": false },
        "pii":    { "$ref": "#/$defs/pii" },
        "input":  { "$ref": "#/$defs/input" },
        "validators": { "type": "array", "items": { "$ref": "#/$defs/validator" } },
        "next":   { "$ref": "#/$defs/id" }
      },
      "required": ["slot", "prompt", "next"]
    },

    "input": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["text", "email", "number", "date", "choice", "yesno", "file"], "default": "text",
                  "description": "file (Ask only): an upload. The answer is {id, name, size, mimeType}; the content is stored in FC_FILES" },
        "accept": { "description": "file: accepted extensions / MIME types, e.g. [\".pdf\", \"image/*\"]",
                    "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "string" }] },
        "maxSizeKb": { "type": "integer", "minimum": 1, "maximum": 20480, "default": 5120 },
        "required": { "type": "boolean", "default": true },
        "placeholder": { "type": "string" },
        "minLength": { "type": "integer" }, "maxLength": { "type": "integer" },
        "min": { "type": "number" }, "max": { "type": "number" },
        "prefix": { "type": "string", "description": "Display prefix for numbers, e.g. $" },
        "minDate": { "type": "string", "description": "YYYY-MM-DD, 'today' or 'tomorrow'" },
        "maxDate": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "object", "required": ["value"],
                     "properties": { "value": { "type": "string" }, "label": { "type": "string" } } }
        },
        "optionsFrom": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$",
                         "description": "choice: id of a lookup list (FC_LOVS in APEX, options.lovs in JS). Replaces options." },
        "optionsParams": { "type": "object", "description": "choice: {param: slot or alias.field} passed to the lookup list (bound as :PARAM)",
                           "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,29}$" },
                           "additionalProperties": { "type": "string" } },
        "display": { "enum": ["auto", "buttons", "list"], "default": "auto",
                     "description": "choice: buttons, or a searchable list. auto = list when there are more than 8 options" },
        "staleMessage": { "type": "string", "description": "choice: shown when an earlier answer is no longer offered" },
        "emptyMessage": { "type": "string", "description": "choice: shown when a lookup list has no options" },
        "requiredMessage": { "type": "string" }, "parseMessage": { "type": "string" },
        "minMessage": { "type": "string" }, "maxMessage": { "type": "string" }
      }
    },

    "validator": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "properties": { "type": { "const": "regex" }, "pattern": { "type": "string" }, "message": { "type": "string" } },
          "required": ["pattern"] },
        { "properties": { "type": { "const": "server" }, "connector": { "type": "string" }, "message": { "type": "string" } },
          "required": ["connector"] }
      ]
    },

    "condExpr": {
      "type": "object",
      "description": "Either a comparison {slot, op, value} or a combination {all:[..]} / {any:[..]} / {not:{..}}",
      "properties": {
        "slot": { "type": "string" },
        "op": { "enum": ["=", "!=", ">", ">=", "<", "<=", "in", "empty", "notEmpty"] },
        "value": {},
        "all": { "type": "array", "items": { "$ref": "#/$defs/condExpr" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/condExpr" } },
        "not": { "$ref": "#/$defs/condExpr" }
      }
    },

    "condition": {
      "properties": {
        "type": { "const": "condition" },
        "branches": { "type": "array", "items": { "type": "object", "required": ["when", "next"],
          "properties": { "when": { "$ref": "#/$defs/condExpr" }, "next": { "$ref": "#/$defs/id" } } } },
        "else": { "$ref": "#/$defs/id" }
      },
      "required": ["branches", "else"]
    },

    "lookup": {
      "properties": { "type": { "const": "lookup" }, "connector": { "type": "string" },
                      "next": { "$ref": "#/$defs/id" }, "onNotFound": { "$ref": "#/$defs/id" } },
      "required": ["connector", "next"]
    },

    "summary": {
      "properties": { "type": { "const": "summary" }, "text": { "type": "string" },
                      "mode": { "enum": ["answers", "changes"], "default": "answers",
                                "description": "changes = show old -> new for the record named in 'record'" },
                      "record": { "$ref": "#/$defs/alias" },
                      "fields": { "type": "array", "items": { "type": "string" } },
                      "confirmLabel": { "type": "string" }, "next": { "$ref": "#/$defs/id" } },
      "required": ["next"]
    },

    "submit": {
      "properties": { "type": { "const": "submit" }, "connector": { "type": "string" },
                      "onSuccess": { "$ref": "#/$defs/id" }, "onError": { "$ref": "#/$defs/id" } },
      "required": ["connector", "onSuccess"]
    },

    "end": {
      "properties": { "type": { "const": "end" }, "text": { "type": "string" } }
    }
  }
}
