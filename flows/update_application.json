{
  "flowId": "update_application",
  "version": 1,
  "name": "Update a loan application",
  "start": "hello",
  "bindings": {
    "app.reference":  { "apex": "P20_REFERENCE",  "dom": "#u_reference" },
    "app.status":     { "apex": "P20_STATUS",     "dom": "#u_status" },
    "app.amount":     { "apex": "P20_AMOUNT",     "dom": "#u_amount" },
    "app.phone":      { "apex": "P20_PHONE",      "dom": "#u_phone" },
    "app.start_date": { "apex": "P20_START_DATE", "dom": "#u_start_date" },
    "app.contact_ok": { "apex": "P20_CONTACT_OK", "dom": "#u_contact_ok" }
  },
  "nodes": [
    { "id": "hello", "type": "message",
      "text": "I can help you update an existing loan application.", "next": "ask_email" },

    { "id": "ask_email", "type": "ask", "slot": "email", "label": "Email",
      "prompt": "What email address did you apply with?",
      "input": { "kind": "email", "placeholder": "name@company.com" }, "next": "ask_ref" },

    { "id": "ask_ref", "type": "ask", "slot": "reference", "label": "Reference",
      "prompt": "Do you have the application reference (e.g. LN-01041)? Skip if not.",
      "input": { "kind": "text", "required": false, "placeholder": "LN-01041" }, "next": "find_app" },

    { "id": "find_app", "type": "findRecord", "source": "loan_apps", "as": "app",
      "criteria": [
        { "field": "email", "op": "eq", "slot": "email" },
        { "field": "reference", "op": "eq", "slot": "reference", "optional": true } ],
      "minCriteria": 1, "maxResults": 5,
      "card": { "title": "{{reference}} · {{purpose}}", "subtitle": "Status {{status}} · phone {{phone}}" },
      "prompts": {
        "many": "I found {{count}} applications for {{email}}. Which one?",
        "none": "I couldn't find an application for those details.",
        "found": "Found application {{app.reference}}." },
      "found": "change", "notFound": "try_again", "cancelled": "try_again" },

    { "id": "try_again", "type": "message",
      "text": "Let's try again. Check the email address you used when you applied.", "next": "ask_email" },

    { "id": "change", "type": "changeFields", "record": "app",
      "cardTitle": "Application {{app.reference}}",
      "prompt": "What would you like to change?",
      "fields": [
        { "field": "phone", "label": "Phone", "input": { "kind": "text", "placeholder": "+1 555 123 4567" },
          "validators": [ { "type": "regex", "pattern": "^\\+?[0-9 ()-]{7,20}$",
                            "message": "That doesn't look like a phone number." } ] },
        { "field": "start_date", "label": "Funds needed by", "input": { "kind": "date", "minDate": "today" } },
        { "field": "contact_ok", "label": "Phone contact OK", "input": { "kind": "yesno" } },
        { "field": "amount", "label": "Loan amount", "input": { "kind": "number", "min": 1000, "max": 500000, "prefix": "$" },
          "editableWhen": { "slot": "app.status", "op": "=", "value": "NEW" },
          "lockedMessage": "The amount can't change once the application is under review." } ],
      "done": "review", "noChanges": "unchanged" },

    { "id": "review", "type": "summary", "mode": "changes", "record": "app",
      "confirmLabel": "Save changes", "next": "save" },

    { "id": "save", "type": "saveChanges", "record": "app",
      "saved": "done", "conflict": "review", "forbidden": "denied", "error": "review" },

    { "id": "done", "type": "end", "text": "Saved! Application {{app.reference}} is up to date." },
    { "id": "unchanged", "type": "end", "text": "No changes were made to {{app.reference}}." },
    { "id": "denied", "type": "end", "text": "Sorry, this application can't be changed online. Please contact support." }
  ]
}
