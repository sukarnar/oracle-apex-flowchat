{
  "flowId": "update_application_public",
  "version": 1,
  "name": "Update a loan application (public page, verified by code)",
  "start": "hello",
  "bindings": {
    "app.reference": {
      "apex": "P20_REFERENCE",
      "dom": "#u_reference"
    },
    "app.status": {
      "apex": "P20_STATUS",
      "dom": "#u_status"
    },
    "app.amount": {
      "apex": "P20_AMOUNT",
      "dom": "#u_amount"
    },
    "app.phone": {
      "apex": "P20_PHONE",
      "dom": "#u_phone"
    },
    "app.start_date": {
      "apex": "P20_START_DATE",
      "dom": "#u_start_date"
    },
    "app.contact_ok": {
      "apex": "P20_CONTACT_OK",
      "dom": "#u_contact_ok"
    }
  },
  "nodes": [
    {
      "id": "hello",
      "type": "message",
      "text": "I can help you update an existing loan application. First I'll confirm it's you.",
      "next": "ask_email"
    },
    {
      "id": "ask_email",
      "type": "ask",
      "slot": "email",
      "label": "Email",
      "prompt": "What email address did you apply with?",
      "input": {
        "kind": "email",
        "placeholder": "name@company.com"
      },
      "next": "verify_email"
    },
    {
      "id": "verify_email",
      "type": "verify",
      "slot": "email",
      "channel": "email",
      "connector": "send_code",
      "codeLength": 6,
      "ttlMinutes": 10,
      "maxAttempts": 3,
      "maxResends": 2,
      "prompts": {
        "sent": "I've emailed a {{codeLength}}-digit code to {{email}}. Please enter it here. It expires in {{ttlMinutes}} minutes.",
        "success": "Thanks, that's confirmed."
      },
      "verified": "ask_ref",
      "failed": "locked"
    },
    {
      "id": "ask_ref",
      "type": "ask",
      "slot": "reference",
      "label": "Reference",
      "prompt": "Do you have the application reference (e.g. LN-01041)? Skip if not.",
      "input": {
        "kind": "text",
        "required": false,
        "placeholder": "LN-01041"
      },
      "next": "find_app"
    },
    {
      "id": "find_app",
      "type": "findRecord",
      "source": "loan_apps_public",
      "as": "app",
      "criteria": [
        {
          "field": "email",
          "op": "eq",
          "slot": "email"
        },
        {
          "field": "reference",
          "op": "eq",
          "slot": "reference",
          "optional": true
        }
      ],
      "minCriteria": 1,
      "maxResults": 5,
      "card": {
        "title": "{{reference}} · {{purpose}}",
        "subtitle": "Status {{status}} · phone {{phone}}"
      },
      "prompts": {
        "many": "I found {{count}} applications for {{email}}. Which one?",
        "none": "I couldn't find an application for {{email}} with those details.",
        "found": "Found application {{app.reference}}."
      },
      "found": "change",
      "notFound": "try_again",
      "cancelled": "try_again",
      "requireVerified": "email"
    },
    {
      "id": "try_again",
      "type": "message",
      "text": "Let's try again with a different reference, or skip it.",
      "next": "ask_ref"
    },
    {
      "id": "change",
      "type": "changeFields",
      "record": "app",
      "cardTitle": "Application {{app.reference}}",
      "prompt": "What would you like to change?",
      "fields": [
        {
          "field": "phone",
          "label": "Phone",
          "input": {
            "kind": "text",
            "placeholder": "+1 555 123 4567"
          },
          "validators": [
            {
              "type": "regex",
              "pattern": "^\\+?[0-9 ()-]{7,20}$",
              "message": "That doesn't look like a phone number."
            }
          ]
        },
        {
          "field": "start_date",
          "label": "Funds needed by",
          "input": {
            "kind": "date",
            "minDate": "today"
          }
        },
        {
          "field": "contact_ok",
          "label": "Phone contact OK",
          "input": {
            "kind": "yesno"
          }
        },
        {
          "field": "amount",
          "label": "Loan amount",
          "input": {
            "kind": "number",
            "min": 1000,
            "max": 500000,
            "prefix": "$"
          },
          "editableWhen": {
            "slot": "app.status",
            "op": "=",
            "value": "NEW"
          },
          "lockedMessage": "The amount can't change once the application is under review."
        }
      ],
      "done": "review",
      "noChanges": "unchanged"
    },
    {
      "id": "review",
      "type": "summary",
      "mode": "changes",
      "record": "app",
      "confirmLabel": "Save changes",
      "next": "save"
    },
    {
      "id": "save",
      "type": "saveChanges",
      "record": "app",
      "saved": "done",
      "conflict": "review",
      "forbidden": "denied",
      "error": "review"
    },
    {
      "id": "done",
      "type": "end",
      "text": "Saved! Application {{app.reference}} is up to date."
    },
    {
      "id": "unchanged",
      "type": "end",
      "text": "No changes were made to {{app.reference}}."
    },
    {
      "id": "denied",
      "type": "end",
      "text": "Sorry, this application can't be changed online. Please contact support."
    },
    {
      "id": "locked",
      "type": "end",
      "text": "For your security I've stopped here. Please start again in a few minutes."
    }
  ]
}
